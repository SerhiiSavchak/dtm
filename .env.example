# Copy to .env.local for local development. Never prefix secrets with NEXT_PUBLIC_.
# Set the same KEY names in Vercel → Project → Settings → Environment Variables
# for Production (and Preview if you test the lead form there).
# Values here are PLACEHOLDERS only — never paste real tokens, keys, chat IDs, or emails.

# --- Telegram lead delivery (server-only). Client bot; client chat is PRIMARY. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIMARY_CHAT_ID=
# Comma-separated numeric chat ids for developer/ops copies. Copy failure does
# not fail the lead if the primary client chat received it.
# Each private chat must /start the CLIENT bot first.
TELEGRAM_COPY_CHAT_IDS=
# Optional forum topic on the PRIMARY chat only. Digits only, otherwise ignored.
TELEGRAM_MESSAGE_THREAD_ID=

# --- Email duplicate channel (server-only). Client inbox is PRIMARY. ---
RESEND_API_KEY=
LEADS_FROM_EMAIL=
LEAD_EMAIL_TO=
LEAD_EMAIL_COPY_TO=

# --- Optional public CTA overrides (client-visible). Defaults are in source. ---
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PHONE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_SITE_URL=

# --- Sanity Studio (/admin) + public CMS reads. Public project id + dataset. ---
# REQUIRED on Vercel Production (and Preview if used). Values are inlined at build
# time — add or change them, then redeploy.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- CLI / migration scripts only (server-side, never NEXT_PUBLIC_). ---
SANITY_AUTH_TOKEN=

# --- On-demand CMS cache invalidation (server-only, never NEXT_PUBLIC_). ---
SANITY_REVALIDATE_SECRET=
