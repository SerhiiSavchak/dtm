# Lead delivery — server-only. Never prefix these with NEXT_PUBLIC_.
# Set the same keys in Vercel → Project → Settings → Environment Variables
# for Production, Preview, and Development as needed.

# Telegram Bot API (owner notification). TELEGRAM_CHAT_ID must be numeric.
# Automatic owner delivery uses this private chat ID via sendMessage.
# Do not use @xrayboy as chat_id. PUBLIC_TELEGRAM_USERNAME=xrayboy is only
# for visitor draft links (https://t.me/xrayboy?text=...).
# TELEGRAM_MESSAGE_THREAD_ID is optional and unused for this private chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=602338748
TELEGRAM_MESSAGE_THREAD_ID=

# Resend email duplicate. LEADS_TO_EMAIL is the recipient, not the sender.
# LEADS_FROM_EMAIL must be a verified domain in Resend.
RESEND_API_KEY=
LEADS_TO_EMAIL=intelekt200012@gmail.com
LEADS_FROM_EMAIL=DTM Website <leads@your-verified-domain.com>

# Optional public CTA overrides (defaults are already the verified DTM profiles)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PHONE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
