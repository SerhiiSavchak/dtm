# Copy to .env.local for local development. Never prefix secrets with NEXT_PUBLIC_.
# Set the same KEY names in Vercel → Project → Settings → Environment Variables
# for Production (and Preview if you test the lead form there).

# --- Production REQUIRED for lead delivery (server-only) ---
# TELEGRAM_CHAT_ID must be a numeric chat id, not a @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional duplicate channel (server-only). All three needed if used. ---
TELEGRAM_MESSAGE_THREAD_ID=
RESEND_API_KEY=
LEADS_TO_EMAIL=
# After a verified domain: DTM Website <leads@your-domain>
# Resend test sender (only delivers to the email on the Resend account):
# DTM Website <onboarding@resend.dev>
LEADS_FROM_EMAIL=

# --- Optional public CTA overrides (client-visible). Defaults are in source. ---
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PHONE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_SITE_URL=

# --- Sanity Studio (/admin). Public project id + dataset, not a secret. ---
# Create a project at https://www.sanity.io/manage then paste values here
# and in Vercel. CORS: allow http://localhost:3000 and the production origin
# with credentials enabled.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- CLI / migration scripts only (server-side, never NEXT_PUBLIC_). ---
# Obtained via `sanity login` or a project token with write access.
# Not required for public site reads or embedded Studio user sessions.
SANITY_AUTH_TOKEN=
