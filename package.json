{
  "name": "dtm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:leads && npm run test:leads-repeat && npm run test:calc-progress && npm run test:calc-summary && npm run test:reveal && npm run test:portfolio-map && npm run test:portfolio-layout && npm run test:in-progress-map && npm run test:studio-slugify && npm run test:studio-helpers && npm run test:studio-schema && npm run test:sanity-fallback",
    "test:studio-helpers": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-studio-helpers.mjs",
    "test:sanity-fallback": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-sanity-fallback.mjs",
    "test:studio-schema": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-studio-schema.mjs",
    "qa:cms": "node --env-file=.env.local scripts/qa-cms-runner.mjs",
    "test:portfolio-layout": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-portfolio-layout.mjs",
    "test:studio-slugify": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-studio-slugify.mjs",
    "test:leads": "node scripts/verify-leads.mjs",
    "test:e2e": "playwright test",
    "test:leads-repeat": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-leads-repeat.mjs",
    "test:calc-progress": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-calc-progress.mjs",
    "test:calc-summary": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-calc-summary.mjs",
    "test:reveal": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-reveal-geometry.mjs",
    "test:portfolio-map": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-portfolio-map.mjs",
    "test:in-progress-map": "node --import ./scripts/register-ts-ext.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-in-progress-map.mjs",
    "seed:sanity:test-projects": "node --env-file=.env.local ./node_modules/sanity/bin/sanity exec scripts/seed-sanity-test-projects.mjs --with-user-token",
    "migrate:sanity:portfolio": "node --env-file=.env.local ./node_modules/sanity/bin/sanity exec scripts/migrate-portfolio-to-sanity-development.mjs --with-user-token",
    "migrate:sanity:in-progress": "node --env-file=.env.local ./node_modules/sanity/bin/sanity exec scripts/migrate-in-progress-to-sanity-development.mjs --with-user-token"
  },
  "dependencies": {
    "@sanity/orderable-document-list": "2.0.18",
    "embla-carousel-react": "^8.6.0",
    "libphonenumber-js": "^1.13.11",
    "next": "16.3.0",
    "next-sanity": "^13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "sanity": "^6.10.1",
    "styled-components": "^6.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
