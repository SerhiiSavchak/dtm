# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local audit / encode scratch
/tmp/
/backups/
/tmp-qa/
/tmp-stills/
/scripts/_media-audit.js

# client source media (temporary; never commit originals)
/new-materials/
/public/new-materials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
